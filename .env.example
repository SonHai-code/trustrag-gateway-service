# ---- LLM ----
LLM_PROVIDER=mock            # anthropic | openai | mock
LLM_API_KEY=
LLM_MODEL=
# ---- Retrieval ----
SEARCH_MODE=hybrid
RERANK=true                  # only effective when RERANKER_URL is set
RERANK_MIN_SCORE=0.05
MIN_SCORE=0.35
REWRITE_QUERY=false
# ---- Downstream services ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_docs
EMBEDDING_URL=http://localhost:8001
EMBEDDING_API_KEY=
RERANKER_URL=                # e.g. http://localhost:8002 ; empty = no reranking
RERANKER_API_KEY=
# ---- Protection ----
BASIC_USER=
BASIC_PASSWORD=
