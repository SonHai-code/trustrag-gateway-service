# ---- LLM ----
LLM_PROVIDER=mock            # anthropic | openai | mock
LLM_API_KEY=
LLM_MODEL=
# ---- Retrieval ----
SEARCH_MODE=hybrid
RERANK=true                  # only effective when RERANKER_URL is set
RERANK_MIN_SCORE=0.05
MIN_SCORE=0.35
REWRITE_QUERY=false
# ---- Downstream services ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_docs
EMBEDDING_URL=http://localhost:8001
EMBEDDING_API_KEY=
RERANKER_URL=                # e.g. http://localhost:8002 ; empty = no reranking
RERANKER_API_KEY=
# ---- Protection ----
BASIC_USER=
BASIC_PASSWORD=
# ---- Speed ----
QUERY_CACHE_SIZE=512         # 0 = off
RETRIEVAL_CACHE_SIZE=256     # 0 = off
RETRIEVAL_CACHE_TTL=300      # seconds
ANSWER_CACHE_TTL=0           # >0 replays grounded answers for this many seconds
KEEPWARM_SECONDS=0           # >0 pings the embedding service this often
RERANK_CANDIDATES=20
# ---- Phase 4 ----
INTERNAL_API_KEY=            # services send it as X-API-Key (bypasses the Basic login)
AGENT_URL=                   # e.g. http://trustrag-agent ; empty = Agent mode disabled
AGENT_API_KEY=

# --- several selectable models (see docs/MODELS.md in the agent repo): JSON list, the SAME value on gateway and agent ---
# LLM_MODELS=[{"id":"gpt-4o-mini","provider":"openai","model":"gpt-4o-mini","api_key_env":"OPENAI_API_KEY"},{"id":"claude","provider":"anthropic","model":"claude-sonnet-5-5","api_key_env":"ANTHROPIC_API_KEY"}]
# LLM_DEFAULT_MODEL=gpt-4o-mini
